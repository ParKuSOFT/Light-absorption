<Window x:Class="Light_absorption.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Language="ru-RU" Title="Поглощение света | Виртуальная лаборатория"
        Width="1080" Height="735" MinWidth="850" MinHeight="590"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Foreground="#18313D" Background="#F1F4F5">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9E2E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#427173"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#176D71"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#CC981E"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.46"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#173440" Padding="24,13">
            <DockPanel>
                <Viewbox DockPanel.Dock="Right" Width="95" Margin="20,0,4,0" HorizontalAlignment="Right">
                    <Canvas Width="96" Height="44">
                        <Path Stroke="White" StrokeThickness="2" Data="M0,22 L35,22"/>
                        <Path Fill="#43606A" Stroke="#B4D6D8" Data="M23,38 L42,5 L62,38 Z"/>
                        <Path Stroke="#FF959A" StrokeThickness="2.5" Data="M49,18 L93,6"/>
                        <Path Stroke="#83D5B3" StrokeThickness="2.5" Data="M52,22 L93,22"/>
                        <Path Stroke="#81BCF6" StrokeThickness="2.5" Data="M55,26 L93,38"/>
                    </Canvas>
                </Viewbox>
                <StackPanel><TextBlock Text="ВИРТУАЛЬНАЯ ЛАБОРАТОРИЯ  /  ОПТИКА" Foreground="#A6D6D4" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="Поглощение света" Foreground="White" FontSize="27" FontWeight="SemiBold"/></StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#E5EDEE" Padding="22,7">
            <TextBlock x:Name="RunStatus" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </Border>
        <Grid Margin="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="01  /  ЭКСПЕРИМЕНТ"/>
                        <TextBlock Text="Параметры" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,18"/>
                        <StackPanel IsEnabled="{Binding InputsEnabled}">
                            <TextBlock Text="Максимальная глубина"/>
                            <TextBlock Text="{Binding MaxDepth, StringFormat={}{0:0.0} м}" FontSize="25" FontWeight="SemiBold"/>
                            <Slider x:Name="DepthInput" Minimum="0" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    Value="{Binding MaxDepth, Mode=TwoWay}" AutomationProperties.Name="Максимальная глубина, метры"/>
                            <DockPanel Margin="0,0,0,16"><TextBlock Text="0 м"/><TextBlock Text="10 м" HorizontalAlignment="Right"/></DockPanel>
                            <TextBlock Text="Шаг расчёта, м" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Steps}" SelectedItem="{Binding Step}" ItemStringFormat="0.00"
                                      AutomationProperties.Name="Шаг расчёта, метры" Padding="6"/>
                        </StackPanel>
                        <TextBlock Text="На входе все три канала имеют интенсивность 1." TextWrapping="Wrap" Foreground="#546A72" Margin="0,16"/>
                        <Button x:Name="CalculateButton" Content="Рассчитать" Style="{StaticResource Action}" Command="{Binding CalculateCommand}"/>
                        <Button x:Name="ExportButton" Content="Экспорт в CSV" Style="{StaticResource Action}" Background="#DCE8EA" Foreground="#193F47"
                                Margin="0,8,0,0" Command="{Binding ExportCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="12">
                    <TabControl Padding="2" BorderThickness="0">
                        <TabItem Header="График RGB" Padding="12,5">
                            <DockPanel Margin="4,9,4,0">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5,0,0,4">
                                    <TextBlock Text="R  красный" Foreground="#A82C3D" FontWeight="SemiBold"/>
                                    <TextBlock Text="G  зелёный" Foreground="#11714D" FontWeight="SemiBold" Margin="18,0"/>
                                    <TextBlock Text="B  синий" Foreground="#245D9D" FontWeight="SemiBold"/>
                                </StackPanel>
                                <oxy:PlotView x:Name="Graph" Model="{Binding Plot}" AutomationProperties.Name="Интенсивность каналов по глубине"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Таблица" Padding="12,5">
                            <DataGrid x:Name="ResultsTable" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      AlternatingRowBackground="#F2F7F7" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Глубина, м" Binding="{Binding Depth, StringFormat=F2}" Width="*"/>
                                    <DataGridTextColumn Header="R" Binding="{Binding R, StringFormat=F4}" Width="*"/>
                                    <DataGridTextColumn Header="G" Binding="{Binding G, StringFormat=F4}" Width="*"/>
                                    <DataGridTextColumn Header="B" Binding="{Binding B, StringFormat=F4}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel IsEnabled="{Binding HasResult}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Selected.Depth, StringFormat={}{0:0.00} м, TargetNullValue='Нет данных', FallbackValue='Нет данных'}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="02  /  СВЕТ НА ВЫБРАННОЙ ГЛУБИНЕ"/>
                        </DockPanel>
                        <Slider x:Name="SampleSlider" Minimum="0" Maximum="{Binding LastIndex}" Value="{Binding SelectedIndex, Mode=TwoWay}"
                                IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,7" AutomationProperties.Name="Точка эксперимента"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,7,0"><TextBlock Text="{Binding Selected.R, StringFormat=R: {0:F3}, FallbackValue=R}" Foreground="#A82C3D"/>
                                    <ProgressBar Height="7" Maximum="1" Value="{Binding Selected.R, Mode=OneWay}" Foreground="#BC4651" Background="#F4E6E7"/></StackPanel>
                                <StackPanel Margin="0,0,7,0"><TextBlock Text="{Binding Selected.G, StringFormat=G: {0:F3}, FallbackValue=G}" Foreground="#11714D"/>
                                    <ProgressBar Height="7" Maximum="1" Value="{Binding Selected.G, Mode=OneWay}" Foreground="#15815B" Background="#E0EFE8"/></StackPanel>
                                <StackPanel><TextBlock Text="{Binding Selected.B, StringFormat=B: {0:F3}, FallbackValue=B}" Foreground="#245D9D"/>
                                    <ProgressBar Height="7" Maximum="1" Value="{Binding Selected.B, Mode=OneWay}" Foreground="#3878BE" Background="#E0EAF5"/></StackPanel>
                            </UniformGrid>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="31" Height="31" CornerRadius="4" BorderBrush="#81959D" BorderThickness="1">
                                    <Border.Background><SolidColorBrush Color="{Binding Selected.SampleColor, FallbackValue=#EEF2F3}"/></Border.Background>
                                </Border>
                                <TextBlock Text="Условный&#10;цвет RGB" FontSize="11" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
